{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Run API",
        "type": "debugpy",
        "request": "launch",
        "module": "uvicorn",
        "args": ["api.app:app", "--app-dir", "src", "--reload", "--port", "8000"],
        "cwd": "${workspaceFolder}/backend",
        "justMyCode": false,
        "env": {"no_proxy": "localhost,192.168.1.1,127.0.0.0,127.0.0.1,127.0.1.1,127.0.1.1,local.home"}
      },
      {
        "name": "Run file",
        "type": "debugpy",
        "request": "launch",
        "program": "${file}",
        "console": "integratedTerminal"
      }
    ]
  }
